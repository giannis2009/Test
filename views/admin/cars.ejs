<%- include('_header') %>
<div class="admin-head">
  <h1>Αγγελίες <span class="muted">(<%= total %>)</span></h1>
  <a class="btn btn-brand" href="/admin/cars/new">➕ Νέα αγγελία</a>
</div>

<form method="get" class="toolbar">
  <input type="search" name="q" value="<%= query.q || '' %>" placeholder="Αναζήτηση μάρκας, μοντέλου…">
  <select name="status" onchange="this.form.submit()">
    <option value="">Όλες οι καταστάσεις</option>
    <% Object.entries(C.STATUSES).forEach(([k, v]) => { %><option value="<%= k %>" <%= query.status === k ? 'selected' : '' %>><%= v %></option><% }) %>
  </select>
  <select name="sort" onchange="this.form.submit()">
    <% [['recent', 'Νεότερες'], ['price_desc', 'Τιμή ↓'], ['price_asc', 'Τιμή ↑'], ['year_desc', 'Έτος ↓']].forEach(([k, v]) => { %><option value="<%= k %>" <%= sort === k ? 'selected' : '' %>><%= v %></option><% }) %>
  </select>
  <button class="btn btn-light">Φίλτρο</button>
</form>

<% if (!cars.length) { %>
  <div class="card empty"><p>Δεν βρέθηκαν αγγελίες.</p><a class="btn btn-brand" href="/admin/cars/new">➕ Προσθήκη αυτοκινήτου</a></div>
<% } else { %>
<div class="table-wrap">
<table class="table">
  <thead>
    <tr><th></th><th>Αυτοκίνητο</th><th>Τιμή</th><th>Έτος / km</th><th>Προβολές</th><th>Κατάσταση</th><th>Προτεινόμενο</th><th></th></tr>
  </thead>
  <tbody>
  <% cars.forEach(car => { %>
    <tr>
      <td><img class="thumb" src="<%= car.cover ? `/uploads/${car.cover}` : '/static/img/no-photo.svg' %>" alt=""></td>
      <td>
        <a href="/admin/cars/<%= car.id %>/edit"><strong><%= car.make %> <%= car.model %></strong></a>
        <div class="muted small"><%= car.version || '' %> · #<%= car.id %> · 📷 <%= car.image_count %></div>
      </td>
      <td><%= fmt.price(car.price) %></td>
      <td><%= fmt.reg(car) %><div class="muted small"><%= fmt.km(car.mileage) %></div></td>
      <td><%= car.views %></td>
      <td>
        <form method="post" action="/admin/cars/<%= car.id %>/status">
          <input type="hidden" name="_csrf" value="<%= csrf() %>">
          <select name="status" class="status-select status-<%= car.status %>" onchange="this.form.submit()">
            <% Object.entries(C.STATUSES).forEach(([k, v]) => { %><option value="<%= k %>" <%= car.status === k ? 'selected' : '' %>><%= v %></option><% }) %>
          </select>
        </form>
      </td>
      <td>
        <form method="post" action="/admin/cars/<%= car.id %>/status">
          <input type="hidden" name="_csrf" value="<%= csrf() %>">
          <input type="hidden" name="featured" value="<%= car.featured ? '0' : '1' %>">
          <button class="star <%= car.featured ? 'on' : '' %>" title="Προτεινόμενο">★</button>
        </form>
      </td>
      <td class="row-actions">
        <a class="btn btn-light btn-sm" href="/admin/cars/<%= car.id %>/edit">Επεξεργασία</a>
        <a class="btn btn-light btn-sm" href="/admin/preview/<%= car.id %>" target="_blank">Προβολή</a>
        <a class="btn btn-light btn-sm" href="/admin/cars/new?from=<%= car.id %>" title="Αντιγραφή σε νέα αγγελία">Αντιγραφή</a>
        <form method="post" action="/admin/cars/<%= car.id %>/delete" data-confirm="Διαγραφή της αγγελίας «<%= car.make %> <%= car.model %>» και όλων των φωτογραφιών της;">
          <input type="hidden" name="_csrf" value="<%= csrf() %>">
          <button class="btn btn-danger btn-sm">Διαγραφή</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% } %>

<% if (pages > 1) { %>
  <nav class="pagination">
    <% for (let p = 1; p <= pages; p++) { %><a href="/admin/cars<%= qs(query, { page: p }) %>" class="<%= p === page ? 'current' : '' %>"><%= p %></a><% } %>
  </nav>
<% } %>
<%- include('_footer') %>
