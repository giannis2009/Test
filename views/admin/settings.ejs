<%- include('_header') %>
<div class="admin-head"><h1>Στοιχεία εμπόρου</h1></div>

<form method="post" action="/admin/settings" enctype="multipart/form-data" class="car-form">
  <input type="hidden" name="_csrf" value="<%= csrf() %>">

  <section class="card">
    <h2>Επωνυμία & εμφάνιση</h2>
    <div class="form-grid">
      <label class="field"><span>Όνομα εμπόρου</span><input name="dealer_name" required value="<%= site.dealer_name %>"></label>
      <label class="field span-2"><span>Σλόγκαν</span><input name="tagline" value="<%= site.tagline %>"></label>
      <label class="field"><span>Κύριο χρώμα</span><input name="primary_color" type="color" value="<%= site.primary_color %>"></label>
    </div>
    <div class="form-grid">
      <div class="field">
        <span>Λογότυπο</span>
        <% if (site.logo) { %><img class="settings-img logo" src="/uploads/<%= site.logo %>" alt=""><label class="check"><input type="checkbox" name="remove_logo" value="1"> Αφαίρεση</label><% } %>
        <input type="file" name="logo" accept="image/*">
      </div>
      <div class="field span-2">
        <span>Εικόνα εξωφύλλου (banner)</span>
        <% if (site.cover) { %><img class="settings-img" src="/uploads/<%= site.cover %>" alt=""><label class="check"><input type="checkbox" name="remove_cover" value="1"> Αφαίρεση</label><% } %>
        <input type="file" name="cover" accept="image/*">
      </div>
    </div>
  </section>

  <section class="card">
    <h2>Επικοινωνία</h2>
    <div class="form-grid">
      <label class="field"><span>Τηλέφωνο</span><input name="phone" value="<%= site.phone %>"></label>
      <label class="field"><span>Κινητό</span><input name="mobile" value="<%= site.mobile %>"></label>
      <label class="field"><span>WhatsApp (με κωδικό χώρας, π.χ. 30690…)</span><input name="whatsapp" value="<%= site.whatsapp %>"></label>
      <label class="field"><span>Email</span><input name="email" type="email" value="<%= site.email %>"></label>
      <label class="field"><span>Διεύθυνση</span><input name="address" value="<%= site.address %>"></label>
      <label class="field"><span>Πόλη</span><input name="city" value="<%= site.city %>"></label>
      <label class="field span-2"><span>Αναζήτηση χάρτη (προαιρετικά, αλλιώς χρησιμοποιείται η διεύθυνση)</span><input name="map_embed_query" value="<%= site.map_embed_query %>"></label>
      <label class="field"><span>Facebook URL</span><input name="facebook" value="<%= site.facebook %>"></label>
      <label class="field"><span>Instagram URL</span><input name="instagram" value="<%= site.instagram %>"></label>
    </div>
    <div class="form-grid">
      <label class="field"><span>Ωράριο</span><textarea name="hours" rows="4"><%= site.hours %></textarea></label>
      <label class="field span-2"><span>Σχετικά με εμάς</span><textarea name="about" rows="4"><%= site.about %></textarea></label>
    </div>
  </section>

  <div class="form-actions"><button class="btn btn-brand">💾 Αποθήκευση</button></div>
</form>
<%- include('_footer') %>
