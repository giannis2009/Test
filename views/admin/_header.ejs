<%- include('../partials/head') %>
<body class="admin-body">
<div class="admin-shell">
  <aside class="admin-side">
    <a class="admin-brand" href="/admin"><img src="<%= site.logoWideUrl %>" alt="<%= site.dealer_name %>"><small>Admin Panel</small></a>
    <nav>
      <a href="/admin" class="<%= path === '/' ? 'active' : '' %>">📊 Πίνακας ελέγχου</a>
      <a href="/admin/cars" class="<%= path.startsWith('/cars') && path !== '/cars/new' ? 'active' : '' %>">🚗 Αγγελίες</a>
      <a href="/admin/cars/new" class="<%= path === '/cars/new' ? 'active' : '' %>">➕ Νέα αγγελία</a>
      <a href="/admin/inquiries" class="<%= path === '/inquiries' ? 'active' : '' %>">✉️ Μηνύματα <% if (unreadCount) { %><span class="pill"><%= unreadCount %></span><% } %></a>
      <a href="/admin/settings" class="<%= path === '/settings' ? 'active' : '' %>">🏢 Στοιχεία εμπόρου</a>
      <a href="/admin/account" class="<%= path === '/account' ? 'active' : '' %>">🔑 Λογαριασμός</a>
    </nav>
    <div class="admin-side-foot">
      <a href="/" target="_blank">↗ Προβολή site</a>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <button class="linklike">Αποσύνδεση (<%= user.username %>)</button>
      </form>
    </div>
  </aside>
  <main class="admin-main">
    <% flashes.forEach(f => { %><div class="alert alert-<%= f.type %>"><%= f.message %></div><% }) %>
