<%- include('_header') %>
<div class="admin-head"><h1>Μηνύματα πελατών</h1></div>

<% if (!inquiries.length) { %><div class="card empty"><p>Δεν υπάρχουν μηνύματα ακόμα.</p></div><% } %>

<div class="inquiries">
<% inquiries.forEach(q => { %>
  <article class="card inquiry <%= q.is_read ? '' : 'unread' %>">
    <header>
      <div>
        <strong><%= q.name %></strong>
        <% if (!q.is_read) { %><span class="pill">Νέο</span><% } %>
        <div class="muted small"><%= fmt.date(q.created_at) %></div>
      </div>
      <div class="inquiry-contact">
        <% if (q.phone) { %><a href="tel:<%= q.phone.replace(/\s/g, '') %>">📞 <%= q.phone %></a><% } %>
        <% if (q.email) { %><a href="mailto:<%= q.email %>?subject=<%= encodeURIComponent(q.make ? `${q.make} ${q.model}` : site.dealer_name) %>">✉️ <%= q.email %></a><% } %>
      </div>
    </header>
    <div class="small">Αφορά: <% if (q.cid) { %><a href="/admin/cars/<%= q.cid %>/edit"><%= [q.make, q.model, q.version].filter(Boolean).join(' ') %></a><% } else { %>Γενικό μήνυμα<% } %></div>
    <p class="pre"><%= q.message %></p>
    <footer class="row-actions">
      <form method="post" action="/admin/inquiries/<%= q.id %>/read">
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <input type="hidden" name="read" value="<%= q.is_read ? '0' : '1' %>">
        <button class="btn btn-light btn-sm"><%= q.is_read ? 'Σήμανση ως μη αναγνωσμένο' : '✓ Σήμανση ως αναγνωσμένο' %></button>
      </form>
      <form method="post" action="/admin/inquiries/<%= q.id %>/delete" data-confirm="Διαγραφή μηνύματος;">
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <button class="btn btn-danger btn-sm">Διαγραφή</button>
      </form>
    </footer>
  </article>
<% }) %>
</div>
<%- include('_footer') %>
