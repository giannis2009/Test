<%- include('_header') %>
<div class="admin-head"><h1>Λογαριασμός</h1></div>

<% if (errors.length) { %><div class="alert alert-error"><% errors.forEach(e => { %><div><%= e %></div><% }) %></div><% } %>

<form method="post" action="/admin/account" class="card stack narrow">
  <input type="hidden" name="_csrf" value="<%= csrf() %>">
  <label class="field"><span>Όνομα χρήστη</span><input name="username" required value="<%= user.username %>" autocomplete="username"></label>
  <label class="field"><span>Τρέχων κωδικός *</span><input name="current_password" type="password" required autocomplete="current-password"></label>
  <label class="field"><span>Νέος κωδικός <%= mustChangePassword ? '*' : '(αφήστε κενό αν δεν αλλάζει)' %></span><input name="new_password" type="password" minlength="8" autocomplete="new-password" <%= mustChangePassword ? 'required' : '' %>></label>
  <label class="field"><span>Επιβεβαίωση νέου κωδικού</span><input name="confirm_password" type="password" minlength="8" autocomplete="new-password" <%= mustChangePassword ? 'required' : '' %>></label>
  <button class="btn btn-brand">Αποθήκευση</button>
</form>
<%- include('_footer') %>
