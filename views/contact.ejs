<%- include('partials/header') %>

<div class="container section contact-page">
  <div class="card">
    <h1>Επικοινωνία</h1>
    <p class="muted"><%= site.about %></p>
    <ul class="contact-list">
      <li>📍 <%= site.address %><%= site.city ? `, ${site.city}` : '' %></li>
      <% if (site.phone) { %><li>📞 <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a></li><% } %>
      <% if (site.mobile) { %><li>📱 <a href="tel:<%= site.mobile.replace(/\s/g, '') %>"><%= site.mobile %></a></li><% } %>
      <% if (site.email) { %><li>✉️ <a href="mailto:<%= site.email %>"><%= site.email %></a></li><% } %>
    </ul>
    <h3>Ωράριο</h3>
    <p class="pre"><%= site.hours %></p>
    <% const mapQ = site.map_embed_query || `${site.address} ${site.city}`; %>
    <% if (mapQ.trim()) { %>
      <iframe class="map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Χάρτης"
        src="https://maps.google.com/maps?q=<%= encodeURIComponent(mapQ) %>&output=embed"></iframe>
    <% } %>
  </div>

  <div class="card">
    <h2>Στείλτε μας μήνυμα</h2>
    <% if (sent) { %><div class="alert alert-success">Ευχαριστούμε! Το μήνυμά σας στάλθηκε.</div><% } %>
    <form method="post" action="/contact" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf() %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <input name="name" required maxlength="120" placeholder="Ονοματεπώνυμο *">
      <input name="phone" type="tel" maxlength="40" placeholder="Τηλέφωνο">
      <input name="email" type="email" maxlength="200" placeholder="Email">
      <textarea name="message" required rows="6" maxlength="4000" placeholder="Μήνυμα *"></textarea>
      <button class="btn btn-brand">Αποστολή</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
