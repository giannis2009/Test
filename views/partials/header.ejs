<%- include('head') %>
<body>
<header class="topbar">
  <div class="container topbar-inner">
    <a class="brand" href="/" aria-label="<%= site.dealer_name %>">
      <img class="brand-icon" src="<%= site.logoUrl %>" alt="">
      <img class="brand-wordmark" src="<%= site.logoWideUrl %>" alt="<%= site.dealer_name %>">
    </a>
    <nav class="mainnav" aria-label="Κύριο μενού">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Αγγελίες</a>
      <a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Επικοινωνία</a>
      <% if (user) { %><a href="/admin" class="nav-admin">Admin</a><% } %>
    </nav>
    <% if (site.phone) { %>
      <a class="btn btn-brand btn-call" href="tel:<%= site.phone.replace(/\s/g, '') %>">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        <span><%= site.phone %></span>
      </a>
    <% } %>
  </div>
</header>
<main>
<% if (flashes.length) { %>
  <div class="container flashes">
    <% flashes.forEach(f => { %><div class="alert alert-<%= f.type %>"><%= f.message %></div><% }) %>
  </div>
<% } %>
