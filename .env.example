# Copy this file to .env and fill it in.

# --- Server ---
PORT=3000
NODE_ENV=production
# Public address of the site (used in emails and invoice links)
PUBLIC_URL=https://ezro.example.com
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx, Cloudflare…)
TRUST_PROXY=1
# Optional: where the database and uploads are stored (default ./data)
# DATA_DIR=/var/data/ezro

# --- Owners: these Google emails can open /admin and add other admins ---
ADMIN_EMAILS=you@gmail.com

# --- Google sign-in (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, type "Web") ---
# Add your site URL to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# --- PayPal (developer.paypal.com → Apps & Credentials) ---
PAYPAL_ENV=sandbox          # sandbox while testing, live for real money
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Email for invoices (any SMTP: Gmail app password, Zoho, Brevo, Resend SMTP…) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ezro <invoices@ezro.example.com>"

# --- Google Drive videos (service account) ---
# console.cloud.google.com → IAM → Service accounts → create → Keys → JSON.
# Enable the "Google Drive API". Then share each video in Drive with the service-account email (Viewer).
# Either a path to the JSON file or the JSON itself on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# --- Local testing only (never in production): email login + "Test payment" button ---
# DEV_LOGIN=1
